# ==============================================================================
# Streamlit Cloud Secrets Configuration
# Đặt các biến cấu hình này trong mục Settings -> Secrets trên Streamlit Cloud
# hoặc tạo file .streamlit/secrets.toml khi test local.
# ==============================================================================

# 1. OpenRouter API Key (Khuyên dùng - 100% Free cho model qwen/qwen-2.5-72b-instruct:free)
OPENROUTER_API_KEY = "your_openrouter_api_key_here"

# 2. Google Gemini API Key (Tùy chọn)
GEMINI_API_KEY = "your_gemini_api_key_here"

# 3. Ollama Server URL (Tùy chọn khi kết nối qua Cloudflare Tunnel)
OLLAMA_API_URL = "http://localhost:11434"
