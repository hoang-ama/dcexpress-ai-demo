# ==============================================================================
# DC Express AI Demo - Environment Variables Template
# Sao chép file này thành .env và điền các giá trị thực tế của bạn:
#   cp .env.example .env
# ==============================================================================

# 1. OpenRouter API Key (Dành cho Qwen Free 72B / 7B)
# Đăng ký & lấy API Key hoàn toàn miễn phí (0đ, không cần thẻ tín dụng) tại:
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Google Gemini API Key (Tùy chọn)
# Lấy API Key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Ollama Server URL (Tùy chọn khi chạy model local hoặc remote tunnel)
OLLAMA_API_URL=http://localhost:11434

# 4. Zalo OA & DC Hub Configuration (Tùy chọn cho tích hợp webhook)
ZALO_APP_ID=your_zalo_app_id
ZALO_SECRET_KEY=your_zalo_secret_key
ZALO_OA_ACCESS_TOKEN=your_zalo_access_token
DCHUB_API_KEY=your_dchub_api_key

